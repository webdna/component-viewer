# Run from the sandbox root, where the plugin sits at plugins/component-library (profile §4).
includes:
    - ../../vendor/craftcms/phpstan/phpstan.neon

parameters:
    level: 5
    paths:
        - src
        - tests
    ignoreErrors:
        # Pest binds each test closure to a TestCase at runtime (tests/Pest.php).
        -
            message: '#^Undefined variable: \$this$#'
            path: tests/*
