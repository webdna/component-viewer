{#
 # One component in the workspace (BR-37, BR-38): the preview with its toolbar, and below it the
 # details drawer, a row of tabs (settings, examples, props, source and notes) that opens upward, as in
 # v1. The divider on top of an open drawer sets its height.
 #
 # Test hooks (§7): data-cl-story, data-cl-prop, data-cl-preview, data-cl-device, data-cl-rotate,
 # data-cl-divider, data-cl-drawer, data-cl-drawer-toggle, data-cl-refresh, data-cl-open,
 # data-cl-background, data-cl-props, data-cl-prop-row, data-cl-control. Paths show only with showPaths, which the share viewer leaves off (BR-29).
 # `device` and `deviceOrientation` are the page's only (BR-39): the preview URL never carries
 # them. (Craft's CP layouts own a variable called `orientation`.) `background` is the preview's
 # (BR-41): the address and the preview carry it only when it isn't `defaultBackground`, the
 # component's own.
 #}
{% import '_includes/forms' as forms %}

{% set name = component.name ?? component.handle %}
{% set problems = component.errors|merge(component.warnings) %}
{% set deviceLabels = {
    desktop: 'Desktop'|t('component-library'),
    tablet: 'Tablet'|t('component-library'),
    phone: 'Phone'|t('component-library'),
} %}
{% set labels = {
    devices: deviceLabels,
    landscape: '{device}, landscape'|t('component-library'),
    frameTitle: 'Preview of {component}, example “{story}”, {device}'|t('component-library'),
} %}
{% set deviceLabel = deviceOrientation == 'landscape'
    ? labels.landscape|replace({'{device}': deviceLabels[device]})
    : deviceLabels[device] %}
{% set frameTitle = labels.frameTitle|replace({'{component}': name, '{story}': story.name, '{device}': deviceLabel}) %}
{% set backgroundLabels = {
    site: 'Theme'|t('component-library'),
    light: 'Light'|t('component-library'),
    dark: 'Dark'|t('component-library'),
} %}
{% set tabs = {
    'cl-settings': {label: 'Settings'|t('component-library'), url: '#cl-settings'},
    'cl-examples': {label: 'Examples'|t('component-library'), url: '#cl-examples'},
    'cl-props': {label: 'Props'|t('component-library'), url: '#cl-props'},
    'cl-source': {label: 'Source'|t('component-library'), url: '#cl-source'},
    'cl-notes': {label: 'Notes'|t('component-library'), url: '#cl-notes'},
} %}
{# Craft's own preview art, from its published CP folder (BR-38). #}
{% set art = view.getAssetManager().getPublishedUrl('@app/web/assets/cp/dist', true) ~ '/images/preview' %}

<div class="cl-viewer" data-cl-viewer="{{ config|json_encode }}" data-cl-labels="{{ labels|json_encode }}">
    <section class="cl-ws-preview" aria-label="{{ 'Preview'|t('component-library') }}">
        <div class="cl-pane-header cl-preview-toolbar">
            <div class="cl-devices" role="group" aria-label="{{ 'Device'|t('component-library') }}">
                {% for option, label in deviceLabels %}
                    {% set on = option == device %}
                    <button type="button" class="btn cl-device-btn" title="{{ label }}" data-cl-device="{{ option }}"
                            aria-pressed="{{ on ? 'true' : 'false' }}" tabindex="{{ on ? '0' : '-1' }}">
                        <img src="{{ art }}/icon-{{ option }}.svg" alt="" width="27" height="22">
                        <span class="visually-hidden">{{ label }}</span>
                    </button>
                {% endfor %}
            </div>
            <button type="button" class="btn cl-icon-btn" title="{{ 'Rotate'|t('component-library') }}" data-cl-rotate
                    aria-pressed="{{ deviceOrientation == 'landscape' ? 'true' : 'false' }}" {{ device == 'desktop' ? 'disabled' }}>
                <span class="cl-icon" aria-hidden="true">{{ iconSvg('rotate') }}</span>
                <span class="visually-hidden">{{ 'Rotate'|t('component-library') }}</span>
            </button>

            {# BR-41: a Mode dropdown, laid out like the site switch. viewer.js applies a change at once. #}
            <div class="cl-mode">
                <label for="cl-background">{{ 'Mode'|t('component-library') }}</label>
                <div class="select">
                    <select id="cl-background" data-cl-background>
                        {% for option, label in backgroundLabels %}
                            <option value="{{ option }}" {{ option == background ? 'selected' }}>{{ label }}</option>
                        {% endfor %}
                    </select>
                </div>
            </div>

            {#
             # BR-35: a single site has nothing to switch to. viewer.js switches as soon as the
             # select changes and hides the button, which is there for a page without script.
             #}
            {% if sites|length > 1 %}
                <form class="cl-site" method="get" action="{{ siteForm.action }}" data-cl-site-form>
                    {% for name, value in siteForm.hidden %}
                        {{ hiddenInput(name, value) }}
                    {% endfor %}
                    <label for="cl-site">{{ 'Site'|t('component-library') }}</label>
                    <div class="select">
                        <select id="cl-site" name="site">
                            {% for option in sites %}
                                <option value="{{ option.handle }}" {{ option.id == site.id ? 'selected' }}>{{ option.name }}</option>
                            {% endfor %}
                        </select>
                    </div>
                    <input type="hidden" name="story" value="{{ story.name }}" data-cl-site-story>
                    <input type="hidden" name="props" value="{{ overrides ? overrides|json_encode }}" data-cl-site-props
                           {{ overrides ? '' : 'disabled' }}>
                    <input type="hidden" name="device" value="{{ device }}" data-cl-site-device {{ device == 'desktop' ? 'disabled' }}>
                    <input type="hidden" name="orientation" value="{{ deviceOrientation }}" data-cl-site-orientation {{ device == 'desktop' ? 'disabled' }}>
                    <input type="hidden" name="bg" value="{{ background }}" data-cl-site-background {{ background == defaultBackground ? 'disabled' }}>
                    <button type="submit" class="btn" data-cl-site-submit>{{ 'Switch site'|t('component-library') }}</button>
                </form>
            {% endif %}

            <div class="cl-toolbar-end">
                <button type="button" class="btn cl-icon-btn" title="{{ 'Refresh'|t('component-library') }}" data-cl-refresh>
                    <span class="cl-icon" aria-hidden="true">{{ iconSvg('arrows-rotate') }}</span>
                    <span class="visually-hidden">{{ 'Refresh'|t('component-library') }}</span>
                </button>
                <a class="btn cl-icon-btn" href="{{ previewUrl }}" target="_blank" rel="noopener"
                   title="{{ 'Open in a new tab'|t('component-library') }}" data-cl-open>
                    <span class="cl-icon" aria-hidden="true">{{ iconSvg('arrow-up-right-from-square') }}</span>
                    <span class="visually-hidden">{{ 'Open in a new tab'|t('component-library') }}</span>
                </a>
            </div>
        </div>

        {# BR-38: tablet and phone draw Craft's bezel art always at real size, the stage scrolling when it's smaller. #}
        <div class="cl-stage" data-cl-stage data-device="{{ device }}" data-orientation="{{ deviceOrientation }}"
             style="--cl-phone-top: url('{{ art }}/chrome-phone-top.svg'); --cl-phone-bottom: url('{{ art }}/chrome-phone-bottom.svg'); --cl-tablet-top: url('{{ art }}/chrome-tablet-top.svg'); --cl-tablet-bottom: url('{{ art }}/chrome-tablet-bottom.svg');">
            <div class="cl-device" data-cl-device-box>
                <div class="cl-device-inner">
                    <div class="cl-device-mask" aria-hidden="true"></div>
                    <div class="cl-device-screen">
                        <iframe src="{{ previewUrl }}" title="{{ frameTitle }}" data-cl-preview></iframe>
                    </div>
                </div>
            </div>
        </div>
    </section>

    {# BR-40: shown while the drawer is open. aria-valuenow is its share of the height, set by viewer.js. #}
    <div class="cl-ws-divider" role="separator" tabindex="0" aria-orientation="horizontal" aria-controls="cl-drawer-content"
         aria-label="{{ 'Resize the details'|t('component-library') }}"
         aria-valuemin="0" aria-valuemax="100" aria-valuenow="40"
         title="{{ 'Drag, or use the arrow keys. Double-click to reset.'|t('component-library') }}" data-cl-divider></div>

    {#
     # The drawer starts closed, as in v1, and viewer.js restores it as it was left (BR-40). A tab
     # opens it on that tab, the open tab closes it again, and the toggle does either.
     #}
    <section id="cl-drawer" class="cl-drawer cl-drawer-closed" aria-label="{{ 'Settings and details'|t('component-library') }}" data-cl-drawer>
        <div class="cl-pane-header cl-drawer-bar">
            {% include '_includes/tabs' with {
                tablistLabel: 'Component details'|t('component-library'),
                containerAttributes: {id: 'cl-tabs'},
            } %}
            <button type="button" class="btn chromeless cl-icon-btn cl-drawer-toggle" aria-controls="cl-drawer-content" aria-expanded="false"
                    title="{{ 'Show details'|t('component-library') }}" data-cl-drawer-toggle
                    data-show-label="{{ 'Show details'|t('component-library') }}" data-hide-label="{{ 'Hide details'|t('component-library') }}">
                <span class="cl-icon" aria-hidden="true">{{ iconSvg('chevron-up') }}</span>
                <span class="visually-hidden" data-cl-drawer-toggle-label>{{ 'Show details'|t('component-library') }}</span>
            </button>
        </div>

        <div id="cl-drawer-content" class="cl-pane-content">
            {% if problems %}
                <div class="cl-problems" role="note" aria-label="{{ 'Problems'|t('component-library') }}">
                    <ul>
                        {% for problem in problems %}
                            <li>
                                <code>{{ problem.code }}</code>
                                {% if showPaths %}<code>{{ problem.path }}{{ problem.line ? ':' ~ problem.line }}</code>{% endif %}
                                {{ problem.message }}
                            </li>
                        {% endfor %}
                    </ul>
                </div>
            {% endif %}

            <div id="cl-settings" role="tabpanel" aria-labelledby="tab-cl-settings" class="cl-panel">
                {% if controls is empty %}
                    <p class="zilch">{{ 'This component has no settings.'|t('component-library') }}</p>
                {% else %}
                    <div class="cl-fields">
                        {% for control in controls %}
                            {% set prop = control.prop %}
                            {% set field = {
                                id: 'cl-prop-' ~ prop.name,
                                name: prop.name,
                                label: prop.name,
                                instructions: prop.description,
                                required: prop.required,
                                fieldAttributes: {data: {'cl-prop': prop.name, 'cl-type': prop.type}},
                            } %}
                            {% switch prop.type %}
                                {% case 'bool' %}
                                    {{ forms.checkboxField(field|merge({checked: control.value})) }}
                                {% case 'select' %}
                                    {% set options = prop.required and control.value != '' ? [] : [{label: '—', value: ''}] %}
                                    {% for value, label in prop.options %}
                                        {% set options = options|merge([{label: label, value: value}]) %}
                                    {% endfor %}
                                    {{ forms.selectField(field|merge({options: options, value: control.value})) }}
                                {% case 'icon' %}
                                    {# BR-44: the names in the icons folder, never a path. #}
                                    {% set options = prop.required and control.value != '' ? [] : [{label: '—', value: ''}] %}
                                    {% for iconName in iconNames %}
                                        {% set options = options|merge([{label: iconName, value: iconName}]) %}
                                    {% endfor %}
                                    {{ forms.selectField(field|merge({options: options, value: control.value})) }}
                                {% case 'text' %}
                                    {{ forms.textareaField(field|merge({value: control.value, rows: 4})) }}
                                {% case 'json' %}
                                    {{ forms.textareaField(field|merge({value: control.value, rows: 4, class: 'code'})) }}
                                {% case 'number' %}
                                    {{ forms.textField(field|merge({value: control.value, type: 'number', step: 'any'})) }}
                                {% default %}
                                    {{ forms.textField(field|merge({value: control.value})) }}
                            {% endswitch %}
                        {% endfor %}
                    </div>
                    <button type="button" class="btn" data-cl-reset>{{ 'Reset settings'|t('component-library') }}</button>
                {% endif %}
            </div>

            {# BR-43: the whole API from the tag, code-only props included. Escaped output only. #}
            <div id="cl-props" role="tabpanel" aria-labelledby="tab-cl-props" class="cl-panel hidden">
                {% if component.props is empty %}
                    <p class="zilch">{{ 'This component has no props.'|t('component-library') }}</p>
                {% else %}
                    <div class="cl-props-scroll" tabindex="0">
                        <table class="data fullwidth cl-props" data-cl-props>
                            <thead>
                                <tr>
                                    <th scope="col">{{ 'Name'|t('component-library') }}</th>
                                    <th scope="col">{{ 'Type'|t('component-library') }}</th>
                                    <th scope="col">{{ 'Default'|t('component-library') }}</th>
                                    <th scope="col">{{ 'Options'|t('component-library') }}</th>
                                    <th scope="col">{{ 'Required'|t('component-library') }}</th>
                                    <th scope="col">{{ 'Description'|t('component-library') }}</th>
                                    <th scope="col">{{ 'In the viewer'|t('component-library') }}</th>
                                </tr>
                            </thead>
                            <tbody>
                                {% for prop in component.props %}
                                    <tr data-cl-prop-row="{{ prop.name }}" data-cl-control="{{ prop.control ? 'true' : 'false' }}">
                                        <th scope="row"><code>{{ prop.name }}</code></th>
                                        <td><code>{{ prop.type }}</code></td>
                                        <td>{% if prop.default is null %}—{% else %}<code>{{ prop.default|json_encode(constant('JSON_UNESCAPED_SLASHES') b-or constant('JSON_UNESCAPED_UNICODE')) }}</code>{% endif %}</td>
                                        <td>
                                            {%- if prop.type == 'icon' -%}
                                                {{ '{count} icons'|t('component-library', {count: iconNames|length}) }}
                                            {%- elseif prop.options -%}
                                                {{ prop.options|keys|join(', ') }}
                                            {%- else -%}
                                                —
                                            {%- endif -%}
                                        </td>
                                        <td>{{ prop.required ? 'Yes'|t('component-library') : 'No'|t('component-library') }}</td>
                                        <td>{{ prop.description ?? '' }}</td>
                                        <td>{{ prop.control ? 'Control'|t('component-library') : 'Code only'|t('component-library') }}</td>
                                    </tr>
                                {% endfor %}
                            </tbody>
                        </table>
                    </div>
                {% endif %}
            </div>

            <div id="cl-examples" role="tabpanel" aria-labelledby="tab-cl-examples" class="cl-panel hidden">
                <ul class="cl-stories">
                    {% for option in component.stories %}
                        <li>
                            <button type="button" class="btn" data-cl-story="{{ option.name }}"
                                    aria-pressed="{{ option.name == story.name ? 'true' : 'false' }}">
                                {{- option.name -}}
                            </button>
                        </li>
                    {% endfor %}
                </ul>
            </div>

            <div id="cl-source" role="tabpanel" aria-labelledby="tab-cl-source" class="cl-panel hidden">
                {% for file in sources %}
                    <h3>{{ file.label }}{% if showPaths %} <code class="light">{{ file.path }}</code>{% endif %}</h3>
                    <pre class="cl-code" tabindex="0"><code>{{ file.source }}</code></pre>
                {% endfor %}
            </div>

            <div id="cl-notes" role="tabpanel" aria-labelledby="tab-cl-notes" class="cl-panel hidden">
                {% if component.notes %}
                    <div class="readable">{{ component.notes|md }}</div>
                {% else %}
                    <p class="zilch">{{ 'This component has no notes.'|t('component-library') }}</p>
                {% endif %}
            </div>
        </div>
    </section>
</div>
